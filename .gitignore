# Python environment and caches (rebuild with: python3 -m venv .venv && .venv/bin/pip install -r requirements.txt)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Lichess puzzle database (1.4 GB; re-download from https://database.lichess.org/#puzzles)
data/

# Raw model outputs, run logs, local reports and training data: large, and regenerable by re-running the pipeline.
# The public copies of the reports and graded outputs are in reports/. Never delete results/ (possible training data).
results/

# Trained student checkpoints (LoRA adapters / full models, GBs; regenerable with src/train_sft.py)
ckpt/

# Puzzle pools: regenerable with src/build_pool.py / src/build_collect_pool.py / src/make_subset.py (fixed seeds)
*.jsonl
# ...except the evaluation sets in splits/: a rebuild from a newer Lichess download would differ
!splits/*.jsonl

# Claude Code local state
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Editors / OS
.DS_Store
*.swp
.vscode/
.idea/
